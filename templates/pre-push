#!/usr/bin/env bash
# Baseline local guardrail: block a push that would publish a secret.
# Scans only the commits being pushed, with gitleaks and betterleaks, using the repo's
# .gitleaks.toml when it exists (else the default rules) and .gitleaksignore.
# Install the scanners once from a clone of github-security:
#   scripts/install-tool.sh gitleaks betterleaks
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass on purpose:      git push --no-verify
set -euo pipefail

zero="0000000000000000000000000000000000000000"
config=()
if [ -f .gitleaks.toml ]; then
  config=(--config .gitleaks.toml)
fi

for tool in gitleaks betterleaks; do
  if ! command -v "$tool" >/dev/null; then
    echo "pre-push: $tool not found. Install it (see the comment at the top of this hook)," >&2
    echo "or bypass on purpose with 'git push --no-verify'." >&2
    exit 1
  fi
done

status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # branch deletion
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes" # new branch: the commits no remote has yet
  else
    range="$remote_sha..$local_sha"
  fi
  for tool in gitleaks betterleaks; do
    "$tool" git . "${config[@]}" --redact --no-banner --log-opts="$range" || status=1
  done
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: secrets found. Push blocked. Rotate a real secret, then remove it from the commits." >&2
fi
exit "$status"
