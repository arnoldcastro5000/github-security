# Pinned tool releases for the Baseline, shared by every reusable workflow, the self-test,
# and the local pre-push hook. scripts/install-tool.sh reads this file.
#
# Binary tools: <TOOL>_VERSION, <TOOL>_URL (linux x64 archive), <TOOL>_SHA256 (of the archive).
# Python tools: <TOOL>_VERSION only (installed with pipx).
# Other tools: <TOOL>_VERSION only (read by the workflow that uses them).
#
# Bump rule: pick the newest release that is at least 7 days old (the Dependabot cooldown).
# Bump the version, the URL, and the SHA-256 together. Take the SHA-256 from the release
# asset digest (`gh api repos/<o>/<r>/releases/tags/<tag> --jq '.assets[].digest'`).
# Dependabot does not track this file.

# Secrets
GITLEAKS_VERSION=8.30.1
GITLEAKS_URL=https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz
GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
BETTERLEAKS_VERSION=1.9.0
BETTERLEAKS_URL=https://github.com/betterleaks/betterleaks/releases/download/v1.9.0/betterleaks_1.9.0_linux_x64.tar.gz
